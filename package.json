{
  "name": "indian-document-check",
  "version": "2.0.0",
  "description": "Check that someone's typed details match the Indian government document they uploaded — twelve document types, read-and-fill, and strict JSON-schema structured output.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run vendor --silent && node src/server.js",
    "dev": "npm run vendor --silent && node --watch src/server.js",
    "vendor": "node scripts/sync-vendor.js",
    "samples": "node scripts/generate-synthetic.js && node scripts/generate-dossier.js",
    "test": "node scripts/test-verify.js",
    "cf:dev": "npm run vendor --silent && wrangler dev --port 5285",
    "cf:deploy": "npm run vendor --silent && wrangler deploy",
    "dossier": "node scripts/generate-dossier.js",
    "bench": "node scripts/benchmark.js",
    "video": "node video/slides.js && node video/narrate.js && node video/capture.js && node video/build.js",
    "video:build": "node video/build.js"
  },
  "keywords": [
    "aadhaar",
    "pan",
    "kyc",
    "india",
    "document-verification",
    "structured-output",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "wrangler": "^4.118.0"
  }
}
