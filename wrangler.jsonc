{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indian-document-check",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The page, the shared modules and the sample documents are served straight
  // from ./public. Anything under /api/ falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "OPENROUTER_MODEL": "google/gemini-3.1-flash-lite"
  }

  // OPENROUTER_API_KEY is a secret, not a var:
  //   npx wrangler secret put OPENROUTER_API_KEY
}
